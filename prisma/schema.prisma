// RPA Monitoring Dashboard - Prisma Schema

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ProcessDefinition {
  id                Int      @id @default(autoincrement())
  processName       String   @unique
  owner             String   @default("")
  botType           String   @default("Scheduled") // "Scheduled" | "OnDemand"
  expectedStartTime String   @default("08:00")     // HH:MM — only used by Scheduled bots
  slaMaxDuration    Int      @default(1800)         // seconds (default 30 min)
  createdAt         DateTime @default(now())
}

model SummaryLog {
  id            Int       @id @default(autoincrement())
  transactionId String    @unique @default(cuid())
  processName   String
  status        String    // "Success" | "Failed"
  startTime     DateTime
  endTime       DateTime?
  durationSec   Float
  volumeCount   Int       @default(0)
  remarks       String    @default("")
  runBy         String?
  errorCode     String?
  isLateStart   Boolean   @default(false)
  isSLABreach   Boolean   @default(false)
  createdAt     DateTime  @default(now())

  errorDetail ErrorDetail?

  @@index([processName])
  @@index([status])
  @@index([startTime])
}

model ErrorDetail {
  id             Int     @id @default(autoincrement())
  transactionId  String  @unique
  errorCode      String?
  errorMessage   String  @db.Text
  screenshotPath String  @default("")

  summaryLog SummaryLog @relation(fields: [transactionId], references: [transactionId], onDelete: Cascade)
}

model Developer {
  id        Int      @id @default(autoincrement())
  fullName  String
  email     String   @unique
  createdAt DateTime @default(now())
}
